GSA_DATA_DIR=data/curated
GSA_STORAGE_DIR=storage
GSA_DB_PATH=storage/database/assistant.sqlite3
GSA_LLM_PROVIDER=ollama
GSA_LLM_MODEL=qwen3:4b
GSA_OLLAMA_URL=http://localhost:11434
GSA_EMBEDDING_MODEL=qllama/multilingual-e5-large
GSA_EMBEDDINGS_ENABLED=true
GSA_STT_PROVIDER=enabled
GSA_STT_MODEL=mannix/whisper:large-v3-turbo
GSA_CHUNK_SIZE=900
GSA_CHUNK_OVERLAP=120
GSA_RETRIEVAL_TOP_K=5
GSA_RETRIEVAL_MIN_SCORE=0.05
GSA_MAX_AUDIO_MB=20
GSA_LOG_LEVEL=INFO
